# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
#
# LEARNING NOTE: `.env.example` IS committed; `.env.local` is NOT (see
# .gitignore). The example file is documentation — it tells the next person
# (or future you, or CI) exactly which variables the app needs, without
# leaking any actual values.
#
# Next.js loads `.env*` files from the PROJECT ROOT, not from `src/`, even
# though our code lives in `src/`. That trips people up.
#
# Why `NEXT_PUBLIC_`? That prefix inlines the value into the browser bundle.
# These two values are safe to expose: the publishable key only ever grants
# what Row Level Security allows, and our `destinations` table policy grants
# read-only SELECT. Never give a service-role key the NEXT_PUBLIC_ prefix —
# that key bypasses RLS entirely.
# ---------------------------------------------------------------------------

# Supabase project URL — Supabase dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (starts with `sb_publishable_`) — same settings page
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
